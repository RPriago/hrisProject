{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=peopleflow_dev;Username=peopleflow_app;Password=peopleflow_app_secret"
  },
  "Security": {
    "Csrf": {
      "TokenLifetimeMinutes": 120,
      "AllowedOrigins": [
        "http://localhost:3000",
        "http://localhost:5173",
        "http://localhost:5000",
        "https://localhost:5001"
      ]
    }
  },
  "Storage": {
    "QuarantineBucket": "peopleflow-quarantine",
    "PrivateBucket": "peopleflow-private",
    "MaxFileSizeBytes": 26214400,
    "MaxPresignedExpirySeconds": 120,
    "UseS3": false,
    "Region": "ap-southeast-1"
  }
}
