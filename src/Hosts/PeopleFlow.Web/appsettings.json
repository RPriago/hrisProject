{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "",
  "Security": {
    "AllowHeaderContextOverride": false,
    "ForwardedHeaders": {
      "KnownProxies": []
    },
    "Csrf": {
      "TokenLifetimeMinutes": 120,
      "AllowedOrigins": []
    }
  },
  "Storage": {
    "QuarantineBucket": "peopleflow-quarantine",
    "PrivateBucket": "peopleflow-private",
    "MaxFileSizeBytes": 26214400,
    "MaxPresignedExpirySeconds": 120,
    "UseS3": false,
    "UseClamAvDaemon": false,
    "ClamAvHost": "localhost",
    "ClamAvPort": 3310,
    "Region": "ap-southeast-1"
  }
}
